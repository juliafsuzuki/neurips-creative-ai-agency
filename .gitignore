00_originals/
01_mezzanine/
02_ai_input/
03_ai_output/
05_final/
audio/
stills/

# But DO track a placeholder so the folder structure is visible in git
!00_originals/.gitkeep
!01_mezzanine/.gitkeep
!02_ai_input/.gitkeep
!03_ai_output/.gitkeep
!05_final/.gitkeep
!audio/.gitkeep
!stills/.gitkeep

