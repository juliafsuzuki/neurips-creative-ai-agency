# --- Media (large, regenerable or backed up separately) ----------------------
# Use "dir/*" (not "dir/") so the !negation exceptions below actually work —
# a bare "dir/" exclude blocks git from ever traversing into the directory,
# which silently defeats any !dir/whatever negation.
00_originals/*
01_mezzanine/*
02_ai_input/*
03_ai_output/*
05_final/*
audio/*
stills/*

# But DO track a placeholder so the folder structure is visible in git
!00_originals/.gitkeep
!01_mezzanine/.gitkeep
!02_ai_input/.gitkeep
!03_ai_output/.gitkeep
!05_final/.gitkeep
!audio/.gitkeep
!stills/.gitkeep

# The submitted NeurIPS deliverable is small enough (well under GitHub's
# 100MB limit) and is the one piece of "media" we deliberately publish.
!05_final/Dancing with Genie - Choreographed Movements Meet AI.mp4

# --- Flow transfer working files (large media + identity photos; keep local) --
# Keeps notes (README.md) tracked but excludes video/audio/image assets,
# including personal identity reference photos, from ever reaching GitHub.
03_flow_inputs/**/*.mov
03_flow_inputs/**/*.mp4
03_flow_inputs/**/*.wav
03_flow_inputs/**/*.png
03_flow_inputs/**/*.PNG
03_flow_inputs/**/*.jpg
03_flow_inputs/**/*.JPG
03_flow_inputs/**/*.jpeg
03_flow_inputs/**/*.JPEG

# --- NLE / edit project caches ------------------------------------------------
04_edit/**/CacheClip/
04_edit/**/Renders/
04_edit/**/Proxy/
04_edit/**/*.autosave/
04_edit/**/Backup/

# --- Logs & scratch -----------------------------------------------------------
scripts/*.log
scripts/tmp/
*.tmp

# --- LaTeX build artifacts ------------------------------------------------------
paper/build/
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz

!paper/build/.gitkeep

# --- OS cruft -----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
._*

# --- Editor / IDE -------------------------------------------------------------
.vscode/
.idea/
*.swp
.venv/
paper/build/
paper/**/*.aux
paper/**/*.log
paper/**/*.out
paper/**/*.bbl
paper/**/*.blg
paper/**/*.synctex.gz
paper/supplementary/*.mp4
